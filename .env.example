# Copy to .env (git-ignored) and fill in. Real environment variables override this file.
# ---------- Xero (read-only Custom Connection) ----------
TAS_XERO_CLIENT_ID=
TAS_XERO_CLIENT_SECRET=

# ---------- Email: EITHER Microsoft Graph (production) ----------
TAS_GRAPH_CLIENT_SECRET=

# ---------- OR SMTP (fastest way to a real send; no admin consent needed) ----------
# For Microsoft 365 set deliver.email.smtp.preset = "microsoft-365" in src/config.json,
# for Google Workspace use "gmail". Then:
TAS_SMTP_USER=
TAS_SMTP_PASS=
# TAS_SMTP_HOST=smtp.office365.com
# TAS_SMTP_PORT=587
# TAS_SMTP_FROM=
